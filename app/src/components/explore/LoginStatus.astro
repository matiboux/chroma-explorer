---
import LoginStatusText from '~/components/explore/LoginStatusText.svelte'
import Logout from '~/components/explore/Logout.svelte'

import { defaultLocale } from '~/i18n'
import type { Locales } from '~/i18n'
const locale = (Astro.currentLocale as Locales | undefined) ?? defaultLocale
---

<div class="login-status-wrapper">
	<div class="login-status">
		<LoginStatusText client:visible locale={locale} />
	</div>
	<div class="logout">
		<Logout client:visible locale={locale} logoutRedirect="/" />
	</div>
</div>

<style>
@reference "tailwindcss/theme";

.login-status-wrapper {
	@apply flex justify-between items-center;
	@apply bg-gray-100;

	.login-status {
		@apply flex-grow;
		@apply px-3 py-1;
		@apply text-sm;
	}
}
</style>
